# Apache/xneelo configuration. Confirm AllowOverride and modules on the live account.
Options -Indexes
ErrorDocument 404 /404.html
<IfModule mod_rewrite.c>
 RewriteEngine On
 # Redirect only the confirmed production hosts; local/review hosts remain usable.
 RewriteCond %{HTTP_HOST} ^(www\.)?thechorefacilitator\.co\.za$ [NC]
 RewriteCond %{HTTPS} !=on [OR]
 RewriteCond %{HTTP_HOST} ^www\.thechorefacilitator\.co\.za$ [NC]
 RewriteRule ^ https://thechorefacilitator.co.za%{REQUEST_URI} [R=301,L,NE]
 RewriteCond %{HTTP_HOST} ^thechorefacilitator\.co\.za$ [NC]
 RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
 RewriteRule ^index\.html$ / [R=301,L]
</IfModule>
<IfModule mod_headers.c>
 Header always set X-Content-Type-Options "nosniff"
 Header always set Referrer-Policy "strict-origin-when-cross-origin"
 Header always set X-Frame-Options "SAMEORIGIN"
 Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
 Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
 <FilesMatch "\.(html|css|js)$">
  Header set Cache-Control "no-cache"
 </FilesMatch>
 <FilesMatch "\.(png|jpg|jpeg|webp|woff2)$">
  Header set Cache-Control "public, max-age=604800"
 </FilesMatch>
</IfModule>
<IfModule mod_deflate.c>
 AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/xml text/plain
</IfModule>
<FilesMatch "^(server-config.*\.php|form-schema\.json|.*\.(md|log|bak|env|sql|cjs)|package(-lock)?\.json)$">
 Require all denied
</FilesMatch>
RedirectMatch 404 /\.(git|svn)(/|$)
RedirectMatch 404 /\.(env|github)(/|$|\.)
